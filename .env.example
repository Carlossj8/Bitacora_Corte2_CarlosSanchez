# .env.example — Plantilla de variables de entorno para Docker Compose
# Copiar este archivo a .env y ajustar los valores antes de iniciar los contenedores

# Clave secreta para firma y verificación de tokens JWT (Base64)
JWT_SECRET=TXkgc3VwZXIgc2VjcmV0IGtleSBwYXJhIGVsIHJlc3RhdXJhbnRlIGxhIGJyYXNhIHZpdmE=

# Configuración de PostgreSQL
POSTGRES_DB=restaurante
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Configuración de MongoDB
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=admin
MONGO_INITDB_DATABASE=restaurante
