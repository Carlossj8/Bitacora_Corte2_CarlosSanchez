        <mxCell id="ext_notificaciones" parent="1" style="html=1;whiteSpace=wrap;fillColor=#6C757D;strokeColor=#495057;fontColor=#FFFFFF;rounded=1;shadow=1;arcSize=10;align=center;verticalAlign=top;spacingTop=8;" value="&amp;lt;&amp;lt;External Software System&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;Servicio de Notificaciones&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Infraestructura de mensajería (Push / WebSockets) para alertas en tiempo real al comensal (pedido recibido / listo).&lt;/i&gt;" vertex="1">
